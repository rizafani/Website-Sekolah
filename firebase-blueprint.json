{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role assignment, credentials hash, and security status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "isActive": { "type": "boolean" },
        "isLocked": { "type": "boolean" },
        "failedLoginAttempts": { "type": "integer" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "username", "fullName", "email", "role"]
    },
    "Role": {
      "title": "Role",
      "description": "System or custom role definition in RBAC",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "isSystemRole": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "label"]
    },
    "Permission": {
      "title": "Permission",
      "description": "Granular capability key in RBAC",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "key": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "key", "label"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Junction mapping user to role",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "roleId": { "type": "string", "maxLength": 64 },
        "assignedAt": { "type": "string" },
        "assignedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId", "roleId"]
    },
    "RolePermission": {
      "title": "RolePermission",
      "description": "Junction mapping role to permission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "roleId": { "type": "string", "maxLength": 64 },
        "permissionId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "roleId", "permissionId"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Official institutional profile and contact metadata for SMA Negeri 1 Julok",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "shortName": { "type": "string", "maxLength": 64 },
        "npsn": { "type": "string", "maxLength": 16 },
        "accreditation": { "type": "string", "maxLength": 16 },
        "principalName": { "type": "string", "maxLength": 128 },
        "principalNip": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 255 },
        "village": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "regency": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "npsn", "principalName", "address"]
    },
    "Page": {
      "title": "Page",
      "description": "Custom content management system static or dynamic page",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "authorId": { "type": "string", "maxLength": 128 },
        "menuPlacement": { "type": "string", "enum": ["header", "footer", "both", "none"] },
        "viewCount": { "type": "integer" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "slug", "content", "status"]
    },
    "Post": {
      "title": "Post",
      "description": "Editorial article or news item with publication lifecycle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 255 },
        "slug": { "type": "string", "maxLength": 255 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "approved", "scheduled", "published", "archived", "rejected"] },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "views": { "type": "integer" },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "status", "authorId"]
    },
    "PostCategory": {
      "title": "PostCategory",
      "description": "Category taxonomy for posts and articles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "PostTag": {
      "title": "PostTag",
      "description": "Tag association for post indexing and filtering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "postId": { "type": "string", "maxLength": 64 },
        "tag": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "tag"]
    },
    "PostRevision": {
      "title": "PostRevision",
      "description": "Historical audit version and revision trail for a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "postId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 255 },
        "content": { "type": "string", "maxLength": 50000 },
        "summary": { "type": "string", "maxLength": 500 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "title", "content", "authorId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Urgent or standard broadcast notice from school management",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 255 },
        "content": { "type": "string", "maxLength": 10000 },
        "date": { "type": "string" },
        "targetAudience": { "type": "string", "maxLength": 64 },
        "isUrgent": { "type": "boolean" },
        "downloadUrl": { "type": "string", "maxLength": 1000 },
        "attachmentName": { "type": "string", "maxLength": 255 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "Event": {
      "title": "Event",
      "description": "Calendar schedule, examinations, holidays, or ceremonies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 255 },
        "category": { "type": "string", "maxLength": 64 },
        "date": { "type": "string" },
        "endDate": { "type": "string" },
        "time": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 255 },
        "organizer": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 5000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "category"]
    },
    "Media": {
      "title": "Media",
      "description": "Secure file storage asset metadata with strict MIME and size limits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "filename": { "type": "string", "maxLength": 255 },
        "originalName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "integer" },
        "url": { "type": "string", "maxLength": 1000 },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "filename", "mimeType", "fileSize", "url"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty and staff profile directory verified under Dapodik",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "nip": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 128 },
        "education": { "type": "string", "maxLength": 128 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["guru", "tendik"] },
        "isLeader": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nip", "name", "role", "category"]
    },
    "Student": {
      "title": "Student",
      "description": "Protected student directory record [STRICT DEMO/ANONYMIZED DATA ONLY]",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "nisn": { "type": "string", "maxLength": 16 },
        "name": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 64 },
        "major": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "status": { "type": "string", "maxLength": 32 },
        "parentName": { "type": "string", "maxLength": 128 },
        "parentPhone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nisn", "name", "className", "status"]
    },
    "Document": {
      "title": "Document",
      "description": "Public or role-restricted school downloads center file",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 255 },
        "category": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "string", "maxLength": 32 },
        "fileType": { "type": "string", "maxLength": 32 },
        "downloadUrl": { "type": "string", "maxLength": 1000 },
        "downloadCount": { "type": "integer" },
        "isRestricted": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "downloadUrl", "category"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Public inquiries or message sent through school portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "subject": { "type": "string", "maxLength": 255 },
        "message": { "type": "string", "maxLength": 5000 },
        "isRead": { "type": "boolean" },
        "reply": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "subject", "message"]
    },
    "Admission": {
      "title": "Admission",
      "description": "Prospective student application for SPMB pipeline",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "registrationNumber": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "nisn": { "type": "string", "maxLength": 16 },
        "nik": { "type": "string", "maxLength": 20 },
        "birthPlace": { "type": "string", "maxLength": 100 },
        "birthDate": { "type": "string" },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "originSchool": { "type": "string", "maxLength": 128 },
        "parentName": { "type": "string", "maxLength": 128 },
        "parentPhone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "chosenPathway": { "type": "string", "enum": ["Zonasi", "Prestasi Akademik", "Afirmasi", "Perpindahan Tugas Orang Tua"] },
        "averageScore": { "type": "number" },
        "status": { "type": "string", "enum": ["Menunggu Verifikasi", "Berkas Diterima", "Lulus Seleksi", "Cadangan", "Tidak Lulus"] },
        "submissionDate": { "type": "string" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "registrationNumber", "fullName", "nisn", "chosenPathway", "status"]
    },
    "AdmissionDocument": {
      "title": "AdmissionDocument",
      "description": "Uploaded certificate or verification document for an admission record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "admissionId": { "type": "string", "maxLength": 64 },
        "documentType": { "type": "string", "maxLength": 64 },
        "fileUrl": { "type": "string", "maxLength": 1000 },
        "fileSize": { "type": "integer" },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "notes": { "type": "string", "maxLength": 500 },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "admissionId", "documentType", "fileUrl"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or administrative broadcast alert item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 64 },
        "isRead": { "type": "boolean" },
        "targetRole": { "type": "string", "maxLength": 64 },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "type"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security trail record of system modifications and access checks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "userRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 64 },
        "resource": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 1000 },
        "ipAddress": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "BLOCKED"] }
      },
      "required": ["id", "timestamp", "username", "action", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts with credentials hash and role assignment"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "RBAC role definitions"
    },
    "/permissions/{permissionId}": {
      "schema": "Permission",
      "description": "Granular capability definitions"
    },
    "/user_roles/{userRoleId}": {
      "schema": "UserRole",
      "description": "Relational mapping between users and roles"
    },
    "/role_permissions/{rolePermissionId}": {
      "schema": "RolePermission",
      "description": "Relational mapping between roles and permissions"
    },
    "/school_settings/{settingId}": {
      "schema": "SchoolSettings",
      "description": "School organizational identity and settings"
    },
    "/pages/{pageId}": {
      "schema": "Page",
      "description": "Dynamic CMS website pages"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Articles, news, and publications with editorial workflow"
    },
    "/post_categories/{categoryId}": {
      "schema": "PostCategory",
      "description": "Taxonomy categories for articles and posts"
    },
    "/post_tags/{tagId}": {
      "schema": "PostTag",
      "description": "Taxonomy tags for posts"
    },
    "/post_revisions/{revisionId}": {
      "schema": "PostRevision",
      "description": "Editorial revision history and rollback snapshots"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Broadcast notifications and urgent notices"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Calendar events, academic examinations, and activities"
    },
    "/media/{mediaId}": {
      "schema": "Media",
      "description": "Media library assets and document attachments"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Faculty and administrative staff directory"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Protected student directory [ANONYMIZED DEMO DATA ONLY]"
    },
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "Download center documents and official forms"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Public inquiries and contact form submissions"
    },
    "/admissions/{admissionId}": {
      "schema": "Admission",
      "description": "SPMB admissions and student intake records"
    },
    "/admissions/{admissionId}/documents/{docId}": {
      "schema": "AdmissionDocument",
      "description": "Subcollection of verified documents attached to an SPMB application"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-app and user broadcast notifications"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Security and compliance audit trail logs"
    }
  }
}
